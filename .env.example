# Public URL used when generating links (no trailing slash).
BASE_URL=http://localhost:8080

# Host port published by docker compose.
PASTE_PORT=8080

# Replace before any real deployment.
SESSION_SECRET=change-me-session-secret

# Optional overrides (compose defaults these inside the container).
# LISTEN_ADDR=0.0.0.0:8080
# DATA_DIR=/data
# DATABASE_PATH=/data/paste.sqlite
